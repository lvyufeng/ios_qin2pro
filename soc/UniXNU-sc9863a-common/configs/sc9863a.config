# UNISOC SC9863A (SharkL3) shared configuration.
#
# Deliberately minimal: only facts that are true of every SC9863A board. Board
# policy (peripherals, reservations, display) belongs in the device repository.

# Cortex-A55: architectural timer and PAN need no vendor support.
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y

# No Apple AMCC block exists on this SoC; integrity lockdown stays off.
CONFIG_XNU_NATIVE_TRUST_CACHE=0

# Nothing storage-, display- or GPU-related is verified on this SoC yet.
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n